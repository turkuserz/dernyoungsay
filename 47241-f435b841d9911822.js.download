 your RapidAPI billing quota"},"lastError":{"th":"ข้อผิดพลาดล่าสุด","en":"Latest error"},"empty":{"th":"ยังไม่มีข้อมูลจาก Facebook — กรอกลิงก์เพจและ RapidAPI Key ด้านบน แล้วกดปุ่มทดสอบการเชื่อมต่อ","en":"No Facebook data yet — enter the page link and RapidAPI Key above, then click Test connection"},"none":{"th":"—","en":"—"},"badge":{"empty":{"th":"ยังไม่มีข้อมูล","en":"No data"},"ok":{"th":"พร้อมใช้งาน","en":"Ready"},"error":{"th":"มีข้อผิดพลาด","en":"Error"},"quota":{"th":"โควตาเต็ม","en":"Quota full"}},"subtitle":{"empty":{"th":"กดทดสอบการเชื่อมต่อเพื่อดึงชื่อเพจและยอดติดตาม","en":"Click Test connection to fetch the page name and followers"},"ok":{"th":"ข้อมูลพร้อมแสดงบนการ์ด Facebook ด้านล่างเว็บแล้ว","en":"Page info is ready on the Facebook footer card"},"error":{"th":"การดึงข้อมูลล่าสุดไม่สำเร็จ","en":"Latest fetch did not succeed"},"quota":{"th":"ใช้โควตา RapidAPI ครบแล้วในเดือนนี้","en":"RapidAPI quota exhausted this month"}}},"actions":{"testConnection":{"th":"ทดสอบการเชื่อมต่อ","en":"Test connection"},"testing":{"th":"กำลังทดสอบ...","en":"Testing..."},"testSuccess":{"th":"เชื่อมต่อสำเร็จ — ดึงข้อมูล Facebook แล้ว","en":"Connected — Facebook data fetched"},"testFailed":{"th":"ทดสอบไม่สำเร็จ","en":"Connection test failed"},"testCooldown":{"th":"รอ {seconds} วินาทีก่อนทดสอบอีกครั้ง","en":"Wait {seconds}s before testing again"},"resetQuota":{"th":"รีเซ็ตโควตา","en":"Reset quota"},"resettingQuota":{"th":"กำลังรีเซ็ต...","en":"Resetting..."},"resetQuotaSuccess":{"th":"รีเซ็ตโควตาเดือนนี้แล้ว","en":"Monthly quota counter reset"},"resetQuotaConfirmTitle":{"th":"รีเซ็ตโควตา Facebook?","en":"Reset Facebook quota?"},"resetQuotaConfirmDescription":{"th":"จะตั้งตัวนับการใช้งานเดือนนี้กลับเป็น 0 ครั้ง (รีเซ็ตเฉพาะในระบบ ไม่กระทบโควตาบน RapidAPI)","en":"This sets this month’s in-app usage counter back to 0 (does not change RapidAPI billing quota)"},"resetQuotaConfirm":{"th":"รีเซ็ต","en":"Reset"}},"errors":{"FACEBOOK_WIDGET_INVALID_PAGE_URL":{"th":"ลิงก์ Facebook ไม่ถูกต